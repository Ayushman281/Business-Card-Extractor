# Backend-only alternative for direct Uvicorn commands from backend/.
# Prefer ROOT .env with scripts/cloud_backend.py or Docker Compose.
# Enable only on an explicitly selected AWS, Lightning AI or hosted Colab GPU.
EXECUTION_TARGET=disabled
ENABLE_MODEL_INFERENCE=false
MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
MODEL_REVISION=66285546d2b821cf421d4f5eb2576359d3770cd3
MODEL_DTYPE=auto
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Optional absolute hosted path; otherwise HF_HOME/Hugging Face defaults apply.
# MODEL_CACHE_DIR=/absolute/persistent/path/qwen
MAX_FILES_PER_REQUEST=20
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=210
MAX_IMAGE_DIMENSION=1800
MAX_IMAGE_PIXELS=25000000
MODEL_MAX_PIXELS=1003520
MODEL_MAX_NEW_TOKENS=512
MODEL_TIMEOUT_SECONDS=180
JOB_TTL_SECONDS=900
MAX_COMPLETED_JOBS=32
LOG_LEVEL=INFO
CORS_ORIGINS=[]
ENABLE_API_DOCS=false
