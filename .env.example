# One configuration for AWS, Lightning AI or hosted Colab. Never enable on the development PC.
# Set the target AND enable inference explicitly on the selected hosted GPU.
EXECUTION_TARGET=disabled
ENABLE_MODEL_INFERENCE=false
MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
# Official checkpoint revision inspected during source preparation.
MODEL_REVISION=66285546d2b821cf421d4f5eb2576359d3770cd3
MODEL_DTYPE=auto
# Optional absolute hosted cache path. If omitted, Hugging Face uses HF_HOME/defaults.
# MODEL_CACHE_DIR=/absolute/persistent/path/qwen
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MAX_FILES_PER_REQUEST=20
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=210
MAX_IMAGE_DIMENSION=1800
MAX_IMAGE_PIXELS=25000000
MODEL_MAX_PIXELS=1003520
MODEL_MAX_NEW_TOKENS=512
MODEL_TIMEOUT_SECONDS=180
JOB_TTL_SECONDS=900
MAX_COMPLETED_JOBS=32
LOG_LEVEL=INFO
CORS_ORIGINS=[]
ENABLE_API_DOCS=false
# Frontend runtime settings: empty API_BASE_URL uses same-origin /api routes.
# For direct browser calls, set API_BASE_URL to the backend's public HTTPS origin
# and CORS_ORIGINS to a JSON list of the frontend's exact origins.
API_BASE_URL=
# Used by Docker Nginx for same-origin requests; includes scheme, no trailing slash/path.
API_PROXY_URL=http://backend:8000
# First validate from inside the AWS server. Public access is a later step.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
